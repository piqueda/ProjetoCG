# Unity-specific files to ignore
# ==============================

# Directories and files generated by Unity/IDE
/Library/
/Temp/
/Obj/
/Builds/
/Logs/
/UserSettings/

# Visual Studio / IDE related files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.DS_Store
*.pdb

# Unity Asset database cache files
# This is usually covered by /Library, but for safety
*.meta
!Assets/**.meta
!ProjectSettings/**.meta

# Uncomment this line if you use Visual Studio Code
.vscode/

# Ignore the .gitignore file itself if you want, though it should be tracked
# /.gitignore
